#!/bin/bash
SOURCE="$0"
source /usr/lib/elive-tools/functions
EL_REPORTS="1"

main(){
    # pre {{{
    local args_pkexec args_sudo args_su user_target is_home_target_requested SUDO_ASKPASS_SCRIPT ret=0
    local -a pkexec_env

    # }}}

    while [[ $# -gt 0 ]]
    do
        case "$1" in
            -k|--preserve-env)
                shift
                args_sudo="-E $args_sudo"
                args_su="--preserve-environment $args_su"
                ;;
            -H)
                shift
                #export HOME="/root"
                is_home_target_requested=1
                args_sudo="-H $args_sudo"
                ;;
            -u|--user)
                if [[ -n "${2:-}" ]] ; then
                    user_target="$2"
                    shift 2
                else
                    shift
                fi
                ;;
            --user=*)
                user_target="${1#*=}"
                shift
                ;;
            --)
                # no more parameters wanted
                shift
                break
                ;;
            *)
                # this should be the command / parameters themselves
                break
                ;;
        esac
    done

    if [[ $# -eq 0 ]] ; then
        el_debug "gksu: no command specified"
        return 1
    fi

    if [[ -n "$user_target" ]] ; then
        args_pkexec="--user $user_target $args_pkexec"
        args_sudo="-u $user_target $args_sudo"
    fi
    el_debug "gksu options parsed: user_target='$user_target' is_home_target_requested='$is_home_target_requested' args_sudo='$args_sudo' args_pkexec='$args_pkexec' args_su='$args_su'"

    if ((is_home_target_requested)) ; then
        if [[ -z "$user_target" || "$user_target" = "root" ]] ; then
            export HOME="/root"
        else
            export HOME="/home/$user_target"
        fi
    fi

    if el_check_sudo_automated ; then
        el_debug "gksu: running via automated sudo: $*"
        sudo $args_sudo "$@"
        ret=$?
    elif [[ -n "$DISPLAY" || -n "$WAYLAND_DISPLAY" ]] && command -v zenity >/dev/null 2>&1 && command -v sudo >/dev/null 2>&1 ; then
        # Prefer sudo -A with zenity in GUI sessions so it always prompts graphically as the current user
        SUDO_ASKPASS_SCRIPT=$(mktemp)
        printf '#!/bin/sh\nexec zenity --password --title="Sudo Password Required"\n' > "$SUDO_ASKPASS_SCRIPT"
        chmod +x "$SUDO_ASKPASS_SCRIPT"
        export SUDO_ASKPASS="$SUDO_ASKPASS_SCRIPT"
        el_debug "gksu: running via sudo -A with zenity askpass: $*"
        sudo -A $args_sudo "$@"
        ret=$?
    elif [[ -n "$DISPLAY" || -n "$WAYLAND_DISPLAY" ]] && command -v pkexec >/dev/null 2>&1 ; then
        [[ -n "$DISPLAY" ]] && pkexec_env+=(DISPLAY="$DISPLAY")
        [[ -n "$WAYLAND_DISPLAY" ]] && pkexec_env+=(WAYLAND_DISPLAY="$WAYLAND_DISPLAY")
        [[ -n "$XAUTHORITY" ]] && pkexec_env+=(XAUTHORITY="$XAUTHORITY")
        ((is_home_target_requested)) && pkexec_env+=(HOME="$HOME")
        el_debug "gksu: running via pkexec: $*"
        pkexec $args_pkexec env "${pkexec_env[@]}" "$@"
        ret=$?
    elif [[ -n "$TMUX" ]] || [[ -n "$SSH_CLIENT" ]] ; then
        el_debug "gksu: running via su for user '${user_target:-root}': $*"
        su $args_su -c "$*" "${user_target:-root}"
        ret=$?
    else
        el_debug "gksu: running via sudo fallback: $*"
        sudo $args_sudo "$@"
        ret=$?
    fi

    # Cleanup askpass script if created
    if [[ -n "$SUDO_ASKPASS_SCRIPT" ]] && [[ -f "$SUDO_ASKPASS_SCRIPT" ]]; then
        rm -f "$SUDO_ASKPASS_SCRIPT"
    fi

    el_debug "gksu: finished with exit status $ret"
    return $ret
}

#
#  MAIN
#
main "$@"

# vim: set foldmethod=marker :
